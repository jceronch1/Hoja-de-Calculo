<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hojadecalculo.android"
    android:versionCode="5" android:versionName="1.3.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <application android:label="Hoja de cálculo" android:icon="@drawable/ic_hoja"
        android:theme="@style/AppTheme" android:usesCleartextTraffic="false">
